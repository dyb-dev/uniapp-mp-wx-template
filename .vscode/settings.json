    // #endregion

    // #region CODE: Code Spell Checker 插件配置

    "cSpell.userWords": [
        "autofetch",
        "axios",
        "Cacheable",
        "camelcase",
        "crossorigin",
        "deepmerge",
        "docthis",
        "echarts",
        "endregion",
        "fileheader",
        "frontmatter",
        "funs",
        "gltf",
        "hbuilderx",
        "iife",
        "jsdelivr",
        "jsnext",
        "Lazyload",
        "localforage",
        "micromessenger",
        "nutui-uniapp",
        "njsproj",
        "ntvs",
        "OIDC",
        "pinia",
        "portfinder-sync",
        "precache",
        "precaching",
        "radash",
        "reportDescriptionlessDisables",
        "stylelint",
        "stylelintignore",
        "stylelintrc",
        "timeformat",
        "todohighlight",
        "tsbuildinfo",
        "uniapp",
        "unpackage",
        "unplugin",
        "Vant",
        "vconsole",
        "VITE",
        "vitepress",
        "vueuse",
        "webp",
        "Weixin",
        "zepto",
        "vant",
        "miniprogram",
        "Wechat",
        "persistedstate",
        "iconfont",
        "nutui-iconfont",
        "dcloudio",
        "getphonenumber",
        "chooseavatar",
        "gutterpreview",
        "unocss"
    ],

    // #endregion

    // #region CODE: Image Preview 插件配置

    "gutterpreview.enableReferenceLookup": true,
    "gutterpreview.paths": {
        "/static": "src/static",
        "/subPackages": "src/subPackages"
    },

    // #endregion

    // #region CODE: CSS Peek 插件配置

    "cssPeek.peekToExclude": ["**/node_modules/**", "**/bower_components/**", "**/.history/**", "**/dist/**"],

    // #endregion

    // #region CODE: Better Todo Tree 插件配置

    "better-todo-tree.general.tags": ["TODO:"],
    "better-todo-tree.highlights.foregroundColourScheme": [],
    "better-todo-tree.highlights.backgroundColourScheme": [],
    "better-todo-tree.filtering.excludeGlobs": ["**/node_modules/**", "**/.history/**", "**/dist/**"]

    // #endregion
}
